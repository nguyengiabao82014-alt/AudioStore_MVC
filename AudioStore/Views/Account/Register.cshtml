@{
    ViewBag.Title = "Đăng Ký - AudioStore";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center py-5" style="min-height: 85vh; background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #312e81 100%);">
    <div class="card border-0 rounded-4 shadow-lg p-4 p-md-5 bg-white position-relative" style="width: 100%; max-width: 440px;">

        <!-- Brand Title & Tab Switcher -->
        <div class="text-center mb-4">
            <h2 class="fw-bold tracking-wider mb-1" style="color: #212529; letter-spacing: 1px;">Audio<span style="color: #FFBD00;">Store</span></h2>
            <p class="text-muted small mb-4">Premium Audio & Equipment</p>

            <!-- Tab chuyển đổi qua lại giữa Đăng nhập và Đăng ký -->
            <div class="d-flex justify-content-center border-bottom pb-2 mb-4">
                <a href="@Url.Action("Login", "Account")" class="fw-semibold text-muted pb-2 px-3 text-decoration-none">ĐĂNG NHẬP</a>
                <span class="fw-bold text-dark pb-2 border-bottom border-dark border-3 px-3">ĐĂNG KÝ</span>
            </div>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "needs-validation" }))
        {
            @Html.AntiForgeryToken()

            if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger py-2 px-3 small mb-3 rounded-3 d-flex align-items-center">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            <!-- Họ và tên -->
            <div class="mb-3">
                <label class="form-label text-secondary fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">HỌ VÀ TÊN</label>
                <input type="text" name="FullName" class="form-control px-3 py-2.5 rounded-3 bg-light border-0 shadow-none" required placeholder="Nhập họ và tên của quý khách..." autocomplete="off" style="font-size: 0.9rem;" />
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label class="form-label text-secondary fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">EMAIL</label>
                <input type="email" name="Email" class="form-control px-3 py-2.5 rounded-3 bg-light border-0 shadow-none" required placeholder="Nhập địa chỉ email..." autocomplete="off" style="font-size: 0.9rem;" />
            </div>

            <!-- Mật khẩu -->
            <div class="mb-3">
                <label class="form-label text-secondary fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">MẬT KHẨU</label>
                <input type="password" name="Password" class="form-control px-3 py-2.5 rounded-3 bg-light border-0 shadow-none" required placeholder="Nhập mật khẩu..." style="font-size: 0.9rem;" />
            </div>

            <!-- Nhập lại mật khẩu -->
            <div class="mb-4">
                <label class="form-label text-secondary fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">NHẬP LẠI MẬT KHẨU</label>
                <input type="password" name="ConfirmPassword" class="form-control px-3 py-2.5 rounded-3 bg-light border-0 shadow-none" required placeholder="Xác nhận lại mật khẩu..." style="font-size: 0.9rem;" />
            </div>

            <!-- Nút Đăng Ký -->
            <div class="d-grid mb-3">
                <button type="submit" class="btn py-3 fw-bold rounded-3 shadow-sm auth-btn" style="font-size: 0.9rem;">
                    Đăng Ký Tài Khoản
                </button>
            </div>

            <div class="text-center mt-3">
                <a href="@Url.Action("Index", "Home")" class="text-muted small text-decoration-none">← Quay lại trang chủ</a>
            </div>
        }
    </div>
</div>

<style>
    .form-control:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 2px rgba(255, 189, 0, 0.4) !important;
    }

    .auth-btn {
        background-color: #FFBD00;
        color: #212529;
        transition: all 0.3s ease;
        border: 1px solid #FFBD00;
    }

        .auth-btn:hover {
            background-color: #f7ca00;
            color: #212529;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(255, 189, 0, 0.3);
        }
</style>