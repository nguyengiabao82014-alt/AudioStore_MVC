@model IEnumerable<AudioStore.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng của bạn - Audio Store";
}

<div class="container my-5">
    <h3 class="fw-bold mb-4" style="color: #232f3e;">Giỏ hàng của bạn</h3>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-white rounded shadow-sm border">
            <h5 class="text-muted">Giỏ hàng của bạn đang trống.</h5>
            <a href="@Url.Action("Index", "Home")" class="btn btn-warning mt-3 fw-bold">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cột danh sách sản phẩm -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th scope="col" class="ps-4">Sản phẩm</th>
                                    <th scope="col" class="text-center">Đơn giá</th>
                                    <th scope="col" class="text-center" style="width: 120px;">Số lượng</th>
                                    <th scope="col" class="text-end pe-4">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="img-thumbnail me-3" style="width: 70px; height: 70px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/70';" />
                                                <div>
                                                    <h6 class="mb-0 fw-bold text-dark text-truncate" style="max-width: 250px;" title="@item.ProductName">@item.ProductName</h6>
                                                    <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="text-danger small text-decoration-none mt-1 d-inline-block">Xóa</a>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-semibold text-danger">@string.Format("{0:N0}", item.Price) đ</td>
                                        <td class="text-center">
                                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-flex justify-content-center" }))
                                            {
                                                <input type="hidden" name="id" value="@item.ProductID" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="form-control form-control-sm text-center" style="width: 60px;" onchange="this.form.submit()" />
                                            }
                                        </td>
                                        <td class="text-end pe-4 fw-bold">@string.Format("{0:N0}", item.TotalPrice) đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Cột Tóm tắt thanh toán -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm" style="background-color: #f8f9fa;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Tổng cộng</h5>
                        <div class="d-flex justify-content-between mb-3 fs-5">
                            <span>Tạm tính:</span>
                            <span class="fw-bold text-danger">@string.Format("{0:N0}", Model.Sum(x => x.TotalPrice)) VNĐ</span>
                        </div>
                        <a href="@Url.Action("Checkout", "Cart")" class="btn btn-checkout w-100 py-2 fw-bold fs-5 shadow-sm">Tiến hành thanh toán</a>
                        <div class="text-center mt-3">
                            <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted small">Quay lại mua thêm</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .btn-checkout {
        background-color: #ffd814; /* Vàng chuẩn Amazon */
        color: #0f1111;
        border: 1px solid #fcd200;
        border-radius: 8px;
        transition: background-color 0.2s;
    }

        .btn-checkout:hover {
            background-color: #f7ca00;
        }
</style>