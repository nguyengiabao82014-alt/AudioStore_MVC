@{
    ViewBag.Title = "Đặt hàng thành công";
}

<div class="container my-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 600px;">
        <i class="fas fa-check-circle text-success mb-3" style="font-size: 60px;"></i>
        <h2 class="fw-bold text-success mb-3">Đặt hàng thành công!</h2>
        <p class="text-muted fs-5 mb-4">Cảm ơn bạn đã mua sắm tại Audio Store. Đơn hàng của bạn đang được xử lý và sẽ được giao trong thời gian sớm nhất.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark fw-bold px-4 py-2 rounded-pill">Về trang chủ</a>
