@{
    ViewBag.Title = "Đăng nhập";
}
<div class="container mt-5" style="max-width: 400px;">
    <form action="/Account/Login" method="post">
        <fieldset class="border p-4 rounded shadow-sm bg-white">
            <legend class="w-auto px-2 font-weight-bold text-danger">Đăng Nhập</legend>
            <div class="form-group mb-3">
                <label>Email hoặc Tên đăng nhập</label>
                <input type="text" name="username" class="form-control" required placeholder="Nhập tài khoản..." />
            </div>
            <div class="form-group mb-3">
                <label>Mật khẩu</label>
                <input type="password" name="password" class="form-control" required placeholder="Nhập mật khẩu..." />
            </div>
            <button type="submit" class="btn btn-danger w-100">Đăng Nhập</button>
        </fieldset>
    </form>
</div>