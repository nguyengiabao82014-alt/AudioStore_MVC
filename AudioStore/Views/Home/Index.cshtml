        </div>

        <div class="row g-4">
            <div class="col-6 col-md-4">
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=300&q=70"
                         alt="Tai nghe không dây" />

                    <div class="product-info">
                        <span class="product-tag">Nổi bật</span>
                        <h5>Tai nghe không dây</h5>
                        <p class="product-price">1.290.000đ</p>
                        <a href="#contact" class="btn btn-product">
                            Tìm hiểu thêm
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4">
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?auto=format&fit=crop&w=300&q=70"
                         alt="Loa Bluetooth" />

                    <div class="product-info">
                        <span class="product-tag">Phổ biến</span>
                        <h5>Loa Bluetooth</h5>
                        <p class="product-price">890.000đ</p>
                        <a href="#contact" class="btn btn-product">
                            Tìm hiểu thêm
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4">
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=300&q=70"
                         alt="Tai nghe in-ear" />

                    <div class="product-info">
                        <span class="product-tag">Mới</span>
                        <h5>Tai nghe in-ear</h5>
                        <p class="product-price">590.000đ</p>
                        <a href="#contact" class="btn btn-product">
                            Tìm hiểu thêm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- GIỚI THIỆU -->
<section class="about-section" id="about">
    <div class="container text-center">
        <h2>Về Audio Store</h2>
        <p>
            Audio Store mang đến các sản phẩm âm thanh hiện đại,
            giúp bạn tận hưởng âm nhạc theo cách riêng của mình.
        </p>
    </div>
</section>
<!-- Góc phát nhạc test sản phẩm tích hợp Visualizer -->
<div style="position: fixed; bottom: 20px; right: 20px; background: #131921; color: #ffffff; padding: 12px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.4); z-index: 9999; display: flex; flex-direction: column; gap: 8px; width: 245px;">

    <div style="display: flex; align-items: center; justify-content: space-between;">
        <span style="font-size: 13px; font-weight: bold; color: #ff3333;">Nhạc test sản phẩm</span>

        <!-- Khối biểu đồ sóng âm -->
        <div class="audio-visualizer" id="visualizer">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </div>
    </div>

    <audio id="testAudio" controls style="height: 30px; width: 100%;">
        <source src="@Url.Content("~/Content/audio/test-song.mp3")" type="audio/mpeg">
        Trình duyệt của bạn không hỗ trợ thẻ audio.
    </audio>
</div>

<!-- CSS cho hiệu ứng sóng âm -->
<style>
    .audio-visualizer {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 16px;
    }
    .audio-visualizer .bar {
        width: 3px;
        height: 4px;
        background-color: #ff3333;
        border-radius: 2px;
        transition: height 0.2s;
    }
    /* Khi trạng thái có class 'playing', các thanh sẽ nhún nhảy */
    .audio-visualizer.playing .bar {
        animation: soundWave 0.6s infinite ease-in-out alternate;
    }
    .audio-visualizer.playing .bar:nth-child(1) { animation-delay: 0.1s; }
    .audio-visualizer.playing .bar:nth-child(2) { animation-delay: 0.3s; }
    .audio-visualizer.playing .bar:nth-child(3) { animation-delay: 0.2s; }
    .audio-visualizer.playing .bar:nth-child(4) { animation-delay: 0.4s; }

  @@keyframes soundWave {
    0% { height: 4px; }
    100% { height: 16px; }
}
</style>

<!-- JavaScript điều khiển hiệu ứng theo trạng thái Audio -->
<script>
    const audio = document.getElementById('testAudio');
    const visualizer = document.getElementById('visualizer');

    audio.addEventListener('play', function() {
        visualizer.classList.add('playing');
    });

    audio.addEventListener('pause', function() {
        visualizer.classList.remove('playing');
    });

    audio.addEventListener('ended', function() {
        visualizer.classList.remove('playing');
    });
</script>