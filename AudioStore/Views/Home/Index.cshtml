@{
    ViewData["Title"] = "Trang chủ";
}

<!-- BANNER -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-md-6">
                <span class="hero-label">ÂM THANH CHẤT LƯỢNG CAO</span>

                <h1>Trải nghiệm âm thanh đỉnh cao</h1>

                <p>
                    Khám phá thế giới âm thanh với những mẫu tai nghe,
                    loa Bluetooth và phụ kiện hiện đại tại Audio Store.
                </p>

                <a href="#products" class="btn btn-audio">
                    Khám phá sản phẩm
                </a>
            </div>

            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=500&q=70"
                     alt="Tai nghe Audio Store"
                     class="hero-image" />
            </div>
        </div>
    </div>
</section>

<!-- DANH MỤC -->
<section class="category-section">
    <div class="container">
        <h2 class="section-title">Danh mục sản phẩm</h2>

        <div class="row g-3">
            <div class="col-6 col-md-4">
                <div class="category-card">
                    <div class="category-icon">🎧</div>
                    <h5>Tai nghe</h5>
                    <p>Âm thanh sống động</p>
                </div>
            </div>

            <div class="col-6 col-md-4">
                <div class="category-card">
                    <div class="category-icon">🔊</div>
                    <h5>Loa Bluetooth</h5>
                    <p>Âm nhạc mọi lúc</p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="category-card">
                    <div class="category-icon">🎵</div>
                    <h5>Phụ kiện</h5>
                    <p>Kết nối tiện lợi</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SẢN PHẨM NỔI BẬT -->
