@model IEnumerable<AudioStore.Models.Product>

@{
    ViewBag.Title = "Trang chủ - Audio Store";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center fw-bold">DANH SÁCH SẢN PHẨM</h2>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column text-center">
                        <h5 class="card-title fw-bold text-uppercase">@item.ProductName</h5>
                        <p class="card-text text-danger fw-bold fs-5 my-3">
                            Giá: @item.Price VNĐ
                        </p>
                        <a href="#" class="btn btn-outline-primary mt-auto">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>