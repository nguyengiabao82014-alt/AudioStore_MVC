@{
    ViewData["Title"] = "Trang chủ";
}

<!-- BANNER -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-md-6">
                <span class="hero-label">ÂM THANH CHẤT LƯỢNG CAO</span>

                <h1>Trải nghiệm âm thanh đỉnh cao</h1>

                <p>
                    Khám phá thế giới âm thanh với những mẫu tai nghe,
                    loa Bluetooth và phụ kiện hiện đại tại Audio Store.
                </p>

                <a href="#products" class="btn btn-audio">
                    Khám phá sản phẩm
                </a>
            </div>

            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=500&q=70"
                     alt="Tai nghe Audio Store"
                     class="hero-image" />
            </div>
        </div>
    </div>
</section>

<!-- DANH MỤC -->
<section class="category-section">
    <div class="container">
        <h2 class="section-title">Danh mục sản phẩm</h2>

        <div class="row g-3">
            <div class="col-6 col-md-4">
                <div class="category-card">
                    <div class="category-icon">🎧</div>
                    <h5>Tai nghe</h5>
                    <p>Âm thanh sống động</p>
                </div>
            </div>

            <div class="col-6 col-md-4">
                <div class="category-card">
                    <div class="category-icon">🔊</div>
                    <h5>Loa Bluetooth</h5>
                    <p>Âm nhạc mọi lúc</p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="category-card">
                    <div class="category-icon">🎵</div>
                    <h5>Phụ kiện</h5>
                    <p>Kết nối tiện lợi</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SẢN PHẨM NỔI BẬT -->
<section class="products-section" id="products">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="section-title mb-1">Sản phẩm nổi bật</h2>
                <p class="text-muted mb-0">
                    Lựa chọn âm thanh dành riêng cho bạn
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-6 col-md-4">
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=300&q=70"
                         alt="Tai nghe không dây" />

                    <div class="product-info">
                        <span class="product-tag">Nổi bật</span>
                        <h5>Tai nghe không dây</h5>
                        <p class="product-price">1.290.000đ</p>
                        <a href="#contact" class="btn btn-product">
                            Tìm hiểu thêm
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4">
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?auto=format&fit=crop&w=300&q=70"
                         alt="Loa Bluetooth" />

                    <div class="product-info">
                        <span class="product-tag">Phổ biến</span>
                        <h5>Loa Bluetooth</h5>
                        <p class="product-price">890.000đ</p>
                        <a href="#contact" class="btn btn-product">
                            Tìm hiểu thêm
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-4">
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=300&q=70"
                         alt="Tai nghe in-ear" />

                    <div class="product-info">
                        <span class="product-tag">Mới</span>
                        <h5>Tai nghe in-ear</h5>
                        <p class="product-price">590.000đ</p>
                        <a href="#contact" class="btn btn-product">
                            Tìm hiểu thêm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- GIỚI THIỆU -->
<section class="about-section" id="about">
    <div class="container text-center">
        <h2>Về Audio Store</h2>
        <p>
            Audio Store mang đến các sản phẩm âm thanh hiện đại,
            giúp bạn tận hưởng âm nhạc theo cách riêng của mình.
        </p>
    </div>
</section>
<!-- Góc phát nhạc test sản phẩm -->
<div style="position: fixed; bottom: 20px; right: 20px; background: #131921; color: #ffffff; padding: 12px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.4); z-index: 9999;">
    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: bold; color: #ff3333; text-align: center;">Nhạc test sản phẩm</p>
    <audio controls style="height: 32px; width: 220px;">
        <source src="@Url.Content("~/Content/audio/test-song.mp3")" type="audio/mpeg">
        Trình duyệt của bạn không hỗ trợ thẻ audio.
    </audio>
</div>