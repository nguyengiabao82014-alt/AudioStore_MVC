@{
    ViewBag.Title = "Trang chủ";
}

<!-- BANNER -->
<section class="audio-banner">
    <div class="banner-content">
        <span class="banner-label">AUDIO STORE</span>

        <h1>THẾ GIỚI ÂM THANH</h1>

        <h2>Khám phá âm thanh đỉnh cao</h2>

        <p>
            Khám phá bộ sưu tập tai nghe, loa Bluetooth
            và micro chất lượng với giá tốt nhất.
        </p>

        <a href="#products" class="banner-btn">
            KHÁM PHÁ NGAY →
        </a>
    </div>

    <div class="banner-icon">
        🎧
    </div>
</section>


<!-- DANH MỤC SẢN PHẨM -->
<section class="audio-section">

    <div class="section-heading">
        <h2>DANH MỤC SẢN PHẨM</h2>
        <p>Khám phá các thiết bị âm thanh nổi bật</p>
    </div>

    <div class="category-list">

        <a href="#" class="category-card">
            <div class="category-icon">🎧</div>
            <h3>Tai nghe</h3>
            <p>Âm thanh sống động</p>
        </a>

        <a href="#" class="category-card">
            <div class="category-icon">🔊</div>
            <h3>Loa</h3>
            <p>Âm thanh mạnh mẽ</p>
        </a>

        <a href="#" class="category-card">
            <div class="category-icon">🎤</div>
            <h3>Micro</h3>
            <p>Thu âm chuyên nghiệp</p>
        </a>

    </div>

</section>


