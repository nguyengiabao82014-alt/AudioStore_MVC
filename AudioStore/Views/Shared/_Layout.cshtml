@using AudioStore.Models
@{
    var cart = Session["Cart"] as List<CartItem>;
    int totalCartItems = cart != null ? cart.Sum(c => c.Quantity) : 0;

    List<Categories> navCategories = new List<Categories>();
    List<Brands> navBrands = new List<Brands>();
    try
    {
        using (var dbNav = new DB_AudioStoreEntities())
        {
            navCategories = dbNav.Categories.ToList();
            navBrands = dbNav.Brands.ToList();
        }
    }
    catch { }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Audio Store</title>

    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #eaeded;
            color: #0f1111;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        /* 1. MAIN HEADER CHUẨN AMAZON */
        .main-header {
            background-color: #131921;
            color: #ffffff;
            padding: 10px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .logo-box {
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: #ffbd00;
            padding: 4px 10px;
            border: 1px solid transparent;
            border-radius: 4px;
        }

            .logo-box:hover {
                border-color: #ffbd00;
            }

        .logo-text {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #ffffff;
        }

            .logo-text span {
                color: #ffbd00;
            }

        .logo-curve {
            width: 100%;
            height: 4px;
            border-bottom: 3px solid #ffbd00;
            border-radius: 50%;
            margin-top: -3px;
        }

        /* THANH SEARCH HOẠT ĐỘNG 100% */
        .search-container {
            display: flex;
            flex: 1;
            max-width: 720px;
            height: 42px;
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

            .search-container:focus-within {
                box-shadow: 0 0 0 3px #ff9900;
            }

        .search-category {
            background-color: #f3f3f3;
            border: none;
            padding: 0 12px;
            color: #333;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border-right: 1px solid #cdcdcd;
            max-width: 170px;
            outline: none;
        }

            .search-category:hover {
                background-color: #dadada;
            }

        .search-input {
            width: 100%;
            padding: 0 14px;
            border: none;
            font-size: 15px;
            color: #111;
            outline: none;
        }

        .search-btn {
            background-color: #febd69;
            border: none;
            width: 52px;
            color: #131921;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.2s;
        }

            .search-btn:hover {
                background-color: #f3a847;
            }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-item-link {
            color: #ffffff;
            text-decoration: none;
            padding: 6px 10px;
            border: 1px solid transparent;
            border-radius: 4px;
            font-size: 13px;
            line-height: 1.3;
        }

            .nav-item-link:hover {
                border-color: #ffffff;
                color: #ffffff;
            }

            .nav-item-link strong {
                display: block;
                font-size: 14px;
            }

        .cart-box {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #ffffff;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            padding: 6px 12px;
            border: 1px solid transparent;
            border-radius: 4px;
        }

            .cart-box:hover {
                border-color: #ffffff;
                color: #ffbd00;
            }

        .cart-count {
            color: #ffbd00;
            font-size: 16px;
            font-weight: 800;
        }

        /* 2. SUB-HEADER & MENU XỔ XUỐNG "ALL" TỪ SQL */
        .sub-header {
            background-color: #232f3e;
            color: #ffffff;
            padding: 6px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 14px;
            flex-wrap: wrap;
            position: relative;
        }

            .sub-header > a {
                color: #ffffff;
                text-decoration: none;
                padding: 5px 10px;
                border: 1px solid transparent;
                border-radius: 3px;
                transition: 0.15s;
            }

                .sub-header > a:hover {
                    border-color: #ffffff;
                    color: #ffbd00;
                }

        /* DROPDOWN MENU ALL */
        .all-menu-wrapper {
            position: relative;
            display: inline-block;
        }

        .all-menu-btn {
            background: transparent;
            color: #ffffff;
            border: 1px solid transparent;
            padding: 5px 12px;
            border-radius: 3px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .all-menu-btn:hover {
                border-color: #ffffff;
                color: #ffbd00;
            }

        .all-dropdown-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background-color: #ffffff;
            min-width: 280px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            border-radius: 6px;
            z-index: 9999;
            padding: 12px 0;
            color: #111;
            border: 1px solid #ddd;
        }

        .all-menu-wrapper:hover .all-dropdown-content {
            display: block;
        }

        .dropdown-header-title {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            color: #555;
            padding: 6px 18px;
            letter-spacing: 0.5px;
        }

        .all-dropdown-content a {
            color: #111;
            padding: 8px 18px;
            text-decoration: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
            transition: background 0.15s;
        }

            .all-dropdown-content a:hover {
                background-color: #f3f3f3;
                color: #e47911;
                font-weight: 600;
            }

        .dropdown-divider {
            height: 1px;
            background-color: #e7e7e7;
            margin: 8px 0;
        }

        /* 3. BONG BÓNG TƯ VẤN TRỰC TUYẾN (ZALO / SĐT) */
        .floating-support {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9990;
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: flex-end;
        }

        .support-bubble {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            border-radius: 50px;
            color: #ffffff;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.25);
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .support-bubble:hover {
                transform: translateY(-3px) scale(1.03);
                color: #ffffff;
                box-shadow: 0 6px 20px rgba(0,0,0,0.35);
            }

        .bubble-zalo {
            background: linear-gradient(135deg, #0068ff, #00a2ff);
        }

        .bubble-phone {
            background: linear-gradient(135deg, #e52d27, #b31217);
        }

        /* 4. FOOTER */
        footer {
            background-color: #232f3e;
            color: #ffffff;
            margin-top: 60px;
        }

        .back-to-top {
            background-color: #37475a;
            color: #ffffff;
            text-align: center;
            padding: 14px 0;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: block;
        }

            .back-to-top:hover {
                background-color: #485769;
                color: #ffbd00;
            }

        .footer-content {
            max-width: 1100px;
            margin: 0 auto;
            padding: 35px 20px;
            font-size: 13px;
            line-height: 1.8;
            color: #dddddd;
        }
    </style>
</head>

<body>
    <!-- ================= MAIN HEADER ================= -->
    <header class="main-header">
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="logo-box">
            <div class="logo-text">Audio<span>Store</span></div>
            <div class="logo-curve"></div>
        </a>

        <!-- FORM TÌM KIẾM GỬI THẲNG VỀ HOME/SEARCH -->
        <form action="@Url.Action("Search", "Home", new { area = "" })" method="get" class="search-container">
            <select name="categoryId" class="search-category">
                <option value="">Tất cả danh mục</option>
                @foreach (var cat in navCategories)
                {
                    <option value="@cat.CategoryID" @(Request.QueryString["categoryId"] == cat.CategoryID.ToString() ? "selected" : "")>
                        @cat.CategoryName
                    </option>
                }
            </select>
            <input type="text" name="keyword" class="search-input" value="@Request.QueryString["keyword"]" placeholder="Tìm kiếm thiết bị âm thanh, loa, tai nghe, micro..." autocomplete="off" />
            <button type="submit" class="search-btn" title="Tìm kiếm">🔍</button>
        </form>

        <div class="header-actions">
            @if (Session["User"] != null)
            {
                <span class="nav-item-link" style="cursor: default;">
                    Xin chào,
                    <strong>@Session["FullName"]</strong>
                </span>

                if (Session["RoleID"] != null && (int)Session["RoleID"] == 1)
                {
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="nav-item-link" style="color: #ffbd00; border-color: #ffbd00;">
                        ⚙️ Quản trị
                        <strong>Admin</strong>
                    </a>
                }

                <a href="@Url.Action("Logout", "Account", new { area = "" })" class="nav-item-link">
                    Tài khoản
                    <strong>Đăng xuất</strong>
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "Account", new { area = "" })" class="nav-item-link">
                    Xin chào, Khách
                    <strong>Đăng nhập</strong>
                </a>
                <a href="@Url.Action("Register", "Account", new { area = "" })" class="nav-item-link">
                    Tạo mới
                    <strong>Đăng ký</strong>
                </a>
            }

            <a href="@Url.Action("Index", "Cart", new { area = "" })" class="cart-box">
                🛒 Giỏ hàng <span class="cart-count">(@totalCartItems)</span>
            </a>
        </div>
    </header>

    <!-- ================= SUB-HEADER (MENU ALL ĐỔ DỮ LIỆU TỪ SQL) ================= -->
    <nav class="sub-header">
        <div class="all-menu-wrapper">
            <button type="button" class="all-menu-btn">
                ☰ Tất Cả Danh Mục ▾
            </button>
            <div class="all-dropdown-content">
                <div class="dropdown-header-title">Danh mục thiết bị</div>
                <a href="@Url.Action("Search", "Home", new { area = "", isPromotion = true, sortOrder = "price_asc" })" class="fw-bold text-warning">
                    <span>🔥 Khuyến Mãi Sốc</span> <span>&rsaquo;</span>
                </a>
                @foreach (var cat in navCategories)
                {
                    <a href="@Url.Action("Search", "Home", new { area = "", categoryId = cat.CategoryID })">
                        <span>@cat.CategoryName</span> <span>&rsaquo;</span>
                    </a>
                }

                <div class="dropdown-divider"></div>
                <div class="dropdown-header-title">Thương hiệu nổi bật</div>
                @foreach (var brand in navBrands)
                {
                    <a href="@Url.Action("Search", "Home", new { area = "", brandId = brand.BrandID })">
                        <span>@brand.BrandName</span> <span>&rsaquo;</span>
                    </a>
                }

                <div class="dropdown-divider"></div>
                <div class="dropdown-header-title">Kiểu kết nối</div>
                <a href="@Url.Action("Search", "Home", new { area = "", isWireless = true })">
                    <span>Thiết bị Không dây (Wireless)</span> <span>&rsaquo;</span>
                </a>
                <a href="@Url.Action("Search", "Home", new { area = "", isWireless = false })">
                    <span>Thiết bị Có dây (Wired)</span> <span>&rsaquo;</span>
                </a>
            </div>
        </div>

        <a href="@Url.Action("Index", "Home", new { area = "" })">Trang Chủ</a>
        <a href="@Url.Action("Search", "Home", new { area = "", isWireless = true })">Thiết Bị Không Dây</a>
        @foreach (var cat in navCategories.Take(4))
        {
            <a href="@Url.Action("Search", "Home", new { area = "", categoryId = cat.CategoryID })">@cat.CategoryName</a>
        }
        <a href="@Url.Action("Search", "Home", new { area = "", sortOrder = "price_asc" })">🔥 Khuyến Mãi Tốt</a>
    </nav>

    <!-- ================= MAIN BODY ================= -->
    <main>
        @RenderBody()
    </main>

    <!-- ================= BONG BÓNG TƯ VẤN TRỰC TUYẾN (ZALO / HOTLINE) ================= -->
    <div class="floating-support">
        <a href="https://zalo.me/0901234567" target="_blank" rel="noopener noreferrer" class="support-bubble bubble-zalo" title="Chat Zalo tư vấn âm thanh">
            <span>💬 Chat Zalo Tư Vấn</span>
        </a>
        <a href="tel:0901234567" class="support-bubble bubble-phone" title="Gọi Hotline mua hàng nhanh">
            <span>📞 Hotline: 0932.192.648</span>
        </a>
    </div>

    <!-- ================= CHÂN TRANG (FOOTER) PHONG PHÚ & PHỦ KÍN ================= -->
    <footer style="background-color: #1a222d; color: #b0c0d0; margin-top: 60px; font-size: 13px; line-height: 1.6;">
        <!-- DẢI ĐĂNG KÝ NHẬN TIN (TĨNH, KHÔNG NÚT BẤM GÂY LỖI) -->
        <div style="background-color: #111720; padding: 22px 20px; border-bottom: 1px solid #2a3545;">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3 text-white">
                    <span style="font-size: 20px;">📧</span>
                    <div>
                        <h6 class="fw-bold mb-0 text-white">Đăng ký nhận thông tin khuyến mãi</h6>
                        <span class="small text-muted">Nhận ngay ưu đãi độc quyền dành riêng cho thành viên Audio Store</span>
                    </div>
                </div>
                <div class="text-white-50 small bg-dark px-3 py-2 rounded border border-secondary">
                    Hệ thống thông báo tự động • Bảo mật thông tin tuyệt đối
                </div>
            </div>
        </div>

        <!-- NỘI DUNG CHÍNH CỦA CHÂN TRANG -->
        <div class="container py-5">
            <div class="row g-4">
                <!-- CỘT 1: THÔNG TIN CÔNG TY & ĐỊA CHỈ -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-warning mb-3" style="letter-spacing: -0.5px;">AUDIO STORE (PGI)</h5>
                    <p class="text-white small fw-bold mb-2">Công ty TNHH Real Men  (PGI)</p>

                    <p class="mb-2 text-white-50 small">
                        <strong class="text-light">📍 Trụ sở chính - TP.HCM:</strong><br />
                        10 Trịnh Văn Cấn, Phường Bến Thành, TP. Hồ Chí Minh
                    </p>
                    <p class="mb-2 text-white-50 small">
                        <strong class="text-light">🏢 Tòa nhà văn phòng PGI:</strong><br />
                        5-7 Đường D52, Phường Bảy Hiền, TP. Hồ Chí Minh
                    </p>

                    <div class="mt-3 pt-2 border-top border-secondary">
                        <p class="mb-1 text-light small">📞 <strong>Hotline:</strong> 093 219 2648- 028 6299 0552</p>
                        <p class="mb-1 text-light small">✉️ <strong>Email:</strong> info@audiostore.vn</p>
                        <p class="mb-0 text-white-50 small">🕒 <strong>Giờ làm việc:</strong> T2 - T7 (8h30 - 18h00)</p>
                    </div>
                </div>

                <!-- CỘT 2: HỖ TRỢ KHÁCH HÀNG -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-white mb-3 border-bottom border-secondary pb-2">Hỗ trợ khách hàng</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="@Url.Action("Index", "Home", new { area = "" })" class="text-decoration-none text-white-50 hover-light">Giới thiệu về hệ thống</a></li>
                        <li><a href="@Url.Action("Login", "Account", new { area = "" })" class="text-decoration-none text-white-50 hover-light">Đăng nhập thành viên</a></li>
                        <li><a href="@Url.Action("Index", "Cart", new { area = "" })" class="text-decoration-none text-white-50 hover-light">Giỏ hàng của tôi</a></li>
                        <li><a href="@Url.Action("Search", "Home", new { area = "" })" class="text-decoration-none text-white-50 hover-light">Hướng dẫn mua hàng</a></li>
                        <li><a href="@Url.Action("Search", "Home", new { area = "", isPromotion = true })" class="text-decoration-none text-white-50 hover-light">Tra cứu khuyến mãi</a></li>
                    </ul>
                </div>

                <!-- CỘT 3: CHÍNH SÁCH & BẢO HÀNH -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-white mb-3 border-bottom border-secondary pb-2">Chính sách &amp; Quy định</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><span class="text-white-50">Chính sách bảo hành chính hãng 12 tháng</span></li>
                        <li><span class="text-white-50">Quy định đổi trả và hoàn tiền trong 15 ngày</span></li>
                        <li><span class="text-white-50">Chính sách bảo mật thông tin khách hàng</span></li>
                        <li><span class="text-white-50">Quy chế hoạt động thương mại điện tử</span></li>
                        <li><span class="text-white-50">Chính sách giao hàng toàn quốc</span></li>
                    </ul>
                </div>

                <!-- CỘT 4: THANH TOÁN & CHỨNG NHẬN -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-white mb-3 border-bottom border-secondary pb-2">Phương thức thanh toán</h6>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="badge bg-light text-dark fw-bold px-2 py-1">VISA</span>
                        <span class="badge bg-light text-dark fw-bold px-2 py-1">Mastercard</span>
                        <span class="badge bg-light text-dark fw-bold px-2 py-1">JCB</span>
                        <span class="badge bg-light text-dark fw-bold px-2 py-1">ZaloPay</span>
                        <span class="badge bg-light text-dark fw-bold px-2 py-1">COD (Nhận hàng)</span>
                    </div>

                    <h6 class="fw-bold text-white mb-2 small">Chứng nhận uy tín</h6>
                    <div class="p-2 bg-dark rounded border border-secondary d-inline-block">
                        <span class="text-info fw-bold small">🛡️ ĐÃ THÔNG BÁO BỘ CÔNG THƯƠNG</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- DẢI BẢN QUYỀN CUỐI CÙNG -->
        <div style="background-color: #111720; padding: 18px 20px; border-top: 1px solid #2a3545; text-align: center;">
            <div class="container text-white-50 small">
                <p class="mb-1">&copy; @DateTime.Now.Year Bản quyền thuộc về Nhóm 9 - Dự án AudioStore_MVC. Mọi quyền được bảo lưu.</p>
                <p class="mb-0" style="font-size: 11px;">Hệ thống phân phối thiết bị âm thanh chính hãng cao cấp tại Việt Nam.</p>
            </div>
        </div>

        <!-- NÚT VỀ ĐẦU TRANG (TĨNH, THUẦN CSS/HTML AN TOÀN) -->
        <a href="#" class="back-to-top text-center" style="display: block; background-color: #2a3545; color: #fff; padding: 12px 0; text-decoration: none; font-weight: 600; font-size: 12px;">
            ▲ QUAY LẠI ĐẦU TRANG
        </a>
    </footer>

    <style>
        .hover-light:hover {
            color: #ffbd00 !important;
        }
    </style>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>