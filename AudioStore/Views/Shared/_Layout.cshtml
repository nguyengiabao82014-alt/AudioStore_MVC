<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Audio Store</title>

    @Styles.Render("~/Content/css")
    <link href="@Url.Content("~/Content/site.css")" rel="stylesheet" />
</head>

<body>

    <!-- HEADER -->
    <header class="main-header">

        <div class="header-top">

            <!-- LOGO -->
            <a href="@Url.Action("Index", "Home")" class="logo">
                AUDIO<span>STORE</span>
            </a>

            <!-- SEARCH -->
            <form class="search-box" action="@Url.Action("Index", "Home")" method="get">
                <input type="text"
                       name="search"
                       placeholder="Tìm kiếm tai nghe, loa, micro..." />

                <button type="submit">⌕</button>
            </form>

            <!-- ACCOUNT AND CART -->
            <div class="header-actions">

                <a href="@Url.Action("Login", "Account")" class="header-link">
                    <span class="header-icon">♙</span>
                    <span>
                        <small>Xin chào!</small>
                        <strong>Đăng nhập</strong>
                    </span>
                </a>

                <a href="@Url.Action("Index", "Cart")" class="header-link cart-link">
                    <span class="header-icon">🛒</span>
                    <strong>Giỏ hàng</strong>
                </a>

            </div>
        </div>

        <!-- NAVIGATION -->
        <nav class="main-nav">

            <a href="@Url.Action("Index", "Home")">Trang chủ</a>

            <a href="@Url.Action("Index", "Product")">Tất cả sản phẩm</a>

            <a href="@Url.Action("Index", "Product", new { category = "headphone" })">
                Tai nghe
            </a>

            <a href="@Url.Action("Index", "Product", new { category = "speaker" })">
                Loa
            </a>

            <a href="@Url.Action("Index", "Product", new { category = "microphone" })">
                Micro
            </a>

            <a href="#">Khuyến mãi</a>

            <a href="#">Liên hệ</a>

        </nav>

    </header>


    <!-- MAIN CONTENT -->
    <main class="main-content">
        @RenderBody()
    </main>


    <!-- FOOTER -->
    <footer class="main-footer">

        <div class="footer-container">

            <!-- COLUMN 1 -->
            <div class="footer-column">
                <h2 class="footer-logo">
                    AUDIO<span>STORE</span>
                </h2>

                <p>
                    Audio Store - Thế giới thiết bị âm thanh.
                    Mang đến trải nghiệm âm thanh chất lượng
                    cho mọi khách hàng.
                </p>
            </div>

            <!-- COLUMN 2 -->
            <div class="footer-column">
                <h3>Về chúng tôi</h3>

                <a href="#">Giới thiệu</a>
                <a href="#">Hệ thống cửa hàng</a>
                <a href="#">Tuyển dụng</a>
                <a href="#">Liên hệ</a>
            </div>

            <!-- COLUMN 3 -->
            <div class="footer-column">
                <h3>Hỗ trợ khách hàng</h3>

                <a href="#">Hướng dẫn mua hàng</a>
                <a href="#">Chính sách bảo hành</a>
                <a href="#">Chính sách đổi trả</a>
                <a href="#">Chính sách vận chuyển</a>
            </div>

            <!-- COLUMN 4 -->
            <div class="footer-column">
                <h3>Thông tin liên hệ</h3>

                <p>📍 TP. Hồ Chí Minh</p>
                <p>☎ Hotline: 1900 0000</p>
                <p>✉ Email: audiostore@gmail.com</p>
                <p>⏰ 08:00 - 21:00</p>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© 2026 AUDIO STORE. All Rights Reserved.</p>
        </div>

    </footer>


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>
