@model IEnumerable<AudioStore.Models.Products>
@{
    ViewBag.Title = "Test Hiển Thị Sản Phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Mượn layout gốc để xem tổng thể
}

<div class="container mt-4 mb-5">
    <div class="alert alert-warning text-center shadow-sm">
        <h4>🚀 TRANG TEST DỮ LIỆU SẢN PHẨM</h4>
        <p class="mb-0">Trang này tải trực tiếp 20 sản phẩm từ Database. Bạn có thể xóa `TestController` và thư mục `Views/Test` sau khi xem xong mà không ảnh hưởng hệ thống.</p>
    </div>

    @foreach (var item in Model)
    {
        <div class="card mb-4 shadow" style="border: 1px solid #ccc; border-radius: 8px; overflow: hidden;">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@item.ProductName</h4>
                <span class="badge bg-danger" style="font-size: 16px;">@item.Price.ToString("N0") VNĐ</span>
            </div>

            <div class="card-body">
                <div class="row">
                    <!-- CỘT TRÁI: HÌNH ẢNH & VIDEO -->
                    <div class="col-md-5" style="border-right: 1px solid #eee;">
                        <h6 class="text-primary fw-bold">1. HÌNH ẢNH SẢN PHẨM</h6>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                var images = item.ImageUrl.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                                foreach (var img in images)
                                {
                                    // Xử lý đường dẫn và đảm bảo đuôi mở rộng
                                    string imagePath = img.Trim();

                                    // Nếu chuỗi ảnh không chứa đuôi mở rộng (như .jpg, .png, .webp)
                                    if (!imagePath.Contains("."))
                                    {
                                        // Tự động ghép thêm đuôi .webp dựa trên thực tế file bạn đang có
                                        imagePath += ".webp";
                                    }

                                    // Cấu trúc đường dẫn hoàn chỉnh
                                    string finalUrl = imagePath.StartsWith("~") || imagePath.StartsWith("/")
                                                      ? imagePath
                                                      : "~/Content/Images/products/" + imagePath;

                                    <img src="@Url.Content(finalUrl)" alt="Ảnh SP" class="img-thumbnail" style="width: 120px; height: 120px; object-fit: contain; background: #f8f9fa;" />
                                }
                            }
                            else
                            {
                                <p class="text-muted">Chưa có hình ảnh</p>
                            }
                        </div>

                        <h6 class="text-primary fw-bold">2. VIDEO GIỚI THIỆU</h6>
                        @if (!string.IsNullOrEmpty(item.VideoUrl))
                        {
                            // Fix lỗi Video: Tự động biến đổi link watch?v= thành link embed/
                            string embedUrl = item.VideoUrl;
                            if (embedUrl.Contains("youtube.com/watch?v="))
                            {
                                embedUrl = embedUrl.Replace("youtube.com/watch?v=", "youtube.com/embed/");
                                // Loại bỏ các tham số thừa phía sau dấu & (như list=, t=) để tránh lỗi iframe
                                int ampersandIndex = embedUrl.IndexOf("&");
                                if (ampersandIndex > 0)
                                {
                                    embedUrl = embedUrl.Substring(0, ampersandIndex);
                                }
                            }
                            else if (embedUrl.Contains("youtu.be/"))
                            {
                                // Xử lý link rút gọn của Youtube
                                embedUrl = embedUrl.Replace("youtu.be/", "youtube.com/embed/");
                            }

                            <div class="embed-responsive embed-responsive-16by9 border rounded">
                                <iframe class="embed-responsive-item" src="@embedUrl" style="width:100%; height:220px;" allowfullscreen></iframe>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Chưa có video</p>
                        }
                    </div>

                    <!-- CỘT PHẢI: THÔNG TIN CHI TIẾT -->
                    <div class="col-md-7">
                        <h6 class="text-primary fw-bold">3. THÔNG TIN PHÂN LOẠI</h6>
                        <p class="mb-1">
                            <strong>Phân loại:</strong>
                            @(item.Categories != null ? item.Categories.CategoryName : "Trống")
                            <span class="text-muted">(@(item.Categories != null ? item.Categories.ParentType : "Trống"))</span>
                        </p>
                        <p class="mb-4"><strong>Tồn kho hiện tại:</strong> <span class="text-success fw-bold">@item.StockQuantity chiếc</span></p>

                        <h6 class="text-primary fw-bold">4. MÔ TẢ CHUNG</h6>
                        <div class="p-2 mb-4" style="background-color: #f9f9f9; border-radius: 5px;">
                            @* Dùng Html.Raw để hiển thị đúng thẻ HTML nếu khi nhập bạn có dùng ngắt dòng hoặc in đậm *@
                            @Html.Raw(item.Description)
                        </div>

                        <h6 class="text-primary fw-bold">5. THÔNG SỐ KỸ THUẬT</h6>
                        <div class="p-2" style="background-color: #f1f8ff; border-left: 4px solid #0d6efd;">
                            @Html.Raw(item.Specifications)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>