@model IEnumerable<AudioStore.Models.Products>

@{
    ViewBag.Title = "Danh sách sản phẩm";
}

<h2>Danh sách sản phẩm</h2>

<p>
    @Html.ActionLink("Thêm sản phẩm mới", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped" style="vertical-align: middle;">
    <thead>
        <tr>
            <th>ProductName</th>
            <th>Brand & Type</th>
            <th>Price</th>
            <th>StockQuantity</th>
            <th>IsWireless</th>
            <th>ImgURL</th>
            <th>NonSpecifications</th>
            <th>IsActive</th>
            <th style="width: 100%;">Operation</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            // Lấy ảnh đầu tiên trong chuỗi ImageUrl làm ảnh đại diện
            string firstImage = "/Content/Images/no-image.png";
            if (!string.IsNullOrEmpty(item.ImageUrl))
            {
                var images = item.ImageUrl.Split(';');
                if (images.Length > 0 && !string.IsNullOrEmpty(images[0]))
                {
                    firstImage = images[0];
                }
            }

            <tr>
                <td><strong>@Html.DisplayFor(modelItem => item.ProductName)</strong></td>
                <td>
                    <small>
                        Hãng: @Html.DisplayFor(modelItem => item.Brands.BrandName)<br />
                        Loại: @Html.DisplayFor(modelItem => item.Categories.CategoryName)
                    </small>
                </td>
                <td>@string.Format("{0:N0} VNĐ", item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.StockQuantity)</td>
                <td>
                    @if (item.IsWireless == true)
                    {
                        <span class="label label-success">Wireless</span>
                    }
                    else if (item.IsWireless == false)
                    {
                        <span class="label label-default">Wired</span>
                    }
                    else
                    {
                        <span class="label label-warning">Not Set</span>
                    }
                </td>
                <td>
                    <img src="@firstImage" alt="Thumbnail" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                </td>
                <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Description">
                    @(item.Description != null && item.Description.Length > 40 ? item.Description.Substring(0, 40) + "..." : item.Description)
                </td>
                <td>
                    @if (item.IsActive == true)
                    {
                        <span class="text-success">Activity</span>
                    }
                    else
                    {
                        <span class="text-danger">Rest</span>
                    }
                </td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-xs btn-warning" }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-xs btn-info" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-xs btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>