@model IEnumerable<AudioStore.Models.Orders>

@{
    ViewBag.Title = "Quản trị hệ thống - Admin Dashboard";
}

<div class="my-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Bảng Điều Khiển Quản Trị (Admin Dashboard)</h2>
            <p class="text-muted mb-0">Quản lý toàn diện đơn hàng, sản phẩm, danh mục, thương hiệu và khuyến mãi.</p>
        </div>
        <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="btn btn-warning fw-bold text-dark shadow-sm">
            🧾 Quản lý tất cả đơn hàng (@(ViewBag.TotalOrders ?? 0))
        </a>
    </div>

    <!-- 4 THẺ THỐNG KÊ NHANH -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-4 border-primary">
                <div class="text-muted small fw-bold text-uppercase">Tổng đơn hàng</div>
                <div class="fs-3 fw-bold text-primary">@(ViewBag.TotalOrders ?? 0)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-4 border-warning">
                <div class="text-muted small fw-bold text-uppercase">Đơn chờ xử lý</div>
                <div class="fs-3 fw-bold text-warning">@(ViewBag.PendingOrders ?? 0)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-4 border-success">
                <div class="text-muted small fw-bold text-uppercase">Tổng doanh thu</div>
                <div class="fs-4 fw-bold text-success">@string.Format("{0:N0} đ", ViewBag.TotalRevenue ?? 0m)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-4 border-dark">
                <div class="text-muted small fw-bold text-uppercase">Tổng sản phẩm</div>
                <div class="fs-3 fw-bold text-dark">@(ViewBag.TotalProducts ?? 0)</div>
            </div>
        </div>
    </div>

    <!-- CÁC PHÂN VÙNG QUẢN TRỊ -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3 transition-card">
                <div class="card-body d-flex flex-column">
                    <div class="fs-2 mb-2">🧾</div>
                    <h5 class="fw-bold">Quản lý Đơn hàng</h5>
                    <p class="text-muted small flex-grow-1">Xem tất cả đơn hàng của khách, cập nhật trạng thái giao hàng và chỉnh sửa thông tin nhận hàng.</p>
                    <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="btn btn-danger fw-bold w-100">Vào quản lý đơn hàng</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3 transition-card">
                <div class="card-body d-flex flex-column">
                    <div class="fs-2 mb-2">📦</div>
                    <h5 class="fw-bold">Quản lý Sản phẩm</h5>
                    <p class="text-muted small flex-grow-1">Thêm mới, chỉnh sửa giá bán, số lượng tồn kho, hình ảnh và thông số kỹ thuật thiết bị âm thanh.</p>
                    <a href="@Url.Action("Index", "Products", new { area = "Admin" })" class="btn btn-primary fw-bold w-100">Vào quản lý sản phẩm</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3 transition-card">
                <div class="card-body d-flex flex-column">
                    <div class="fs-2 mb-2">🎟️</div>
                    <h5 class="fw-bold">Quản lý Mã giảm giá</h5>
                    <p class="text-muted small flex-grow-1">Tạo mã khuyến mãi, thiết lập phần trăm giảm, giới hạn tối đa và theo dõi hạn sử dụng.</p>
                    <a href="@Url.Action("Index", "DiscountCodes", new { area = "Admin" })" class="btn btn-success fw-bold w-100">Vào quản lý mã giảm giá</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100 p-3 transition-card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">📂 Quản lý Danh mục</h5>
                        <p class="text-muted small mb-0">Phân loại thiết bị âm thanh (Loa, Tai nghe, Micro...)</p>
                    </div>
                    <a href="@Url.Action("Index", "Categories", new { area = "Admin" })" class="btn btn-outline-dark fw-bold">Quản lý Danh mục →</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100 p-3 transition-card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">🏷️ Quản lý Thương hiệu</h5>
                        <p class="text-muted small mb-0">Quản lý các hãng âm thanh (Marshall, JBL, Sony, Harman Kardon...)</p>
                    </div>
                    <a href="@Url.Action("Index", "Brands", new { area = "Admin" })" class="btn btn-outline-dark fw-bold">Quản lý Thương hiệu →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG HIỂN THỊ TẤT CẢ ĐƠN HÀNG ĐANG CÓ NGAY TRÊN DASHBOARD -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold m-0">📋 Danh sách tất cả đơn hàng đang có</h5>
            <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="btn btn-sm btn-warning fw-bold text-dark">Mở trang Quản lý Đơn hàng đầy đủ →</a>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-4 text-center text-muted">Hiện chưa có đơn hàng nào trong hệ thống.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã ĐH</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th>Địa chỉ giao hàng</th>
                                <th>PT Thanh toán</th>
                                <th class="text-end">Thành tiền</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                string badgeClass = "bg-secondary";
                                string statusLabel = item.Status ?? "Pending";

                                if (statusLabel == "Pending" || statusLabel == "Chờ xử lý") { badgeClass = "bg-warning text-dark"; statusLabel = "Chờ xử lý"; }
                                else if (statusLabel == "Confirmed" || statusLabel == "Đã xác nhận") { badgeClass = "bg-info text-dark"; statusLabel = "Đã xác nhận"; }
                                else if (statusLabel == "Shipping" || statusLabel == "Đang giao hàng") { badgeClass = "bg-primary"; statusLabel = "Đang giao hàng"; }
                                else if (statusLabel == "Completed" || statusLabel == "Đã giao") { badgeClass = "bg-success"; statusLabel = "Đã giao"; }
                                else if (statusLabel == "Cancelled" || statusLabel == "Đã hủy") { badgeClass = "bg-danger"; statusLabel = "Đã hủy"; }

                                <tr>
                                    <td class="ps-3 fw-bold text-primary">#@item.OrderID</td>
                                    <td>
                                        <div class="fw-bold">@(item.Users != null ? item.Users.FullName : "Khách #" + item.UserID)</div>
                                        <small class="text-muted">@(item.Users != null ? item.Users.Email : "")</small>
                                    </td>
                                    <td>@(item.OrderDate.HasValue ? item.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                                    <td style="max-width: 220px;" class="text-truncate" title="@item.ShippingAddress">@item.ShippingAddress</td>
                                    <td>@(item.PaymentMethod == "BankTransfer" ? "Chuyển khoản" : "COD")</td>
                                    <td class="text-end fw-bold text-danger">@string.Format("{0:N0} đ", item.FinalAmount)</td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass">@statusLabel</span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <a href="@Url.Action("Edit", "Orders", new { area = "Admin", id = item.OrderID })" class="btn btn-sm btn-warning fw-bold text-dark">✏️ Sửa đơn</a>
                                        <a href="@Url.Action("Details", "Orders", new { area = "Admin", id = item.OrderID })" class="btn btn-sm btn-info fw-bold text-dark">👁️ Chi tiết</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .transition-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.12) !important;
        }
</style>